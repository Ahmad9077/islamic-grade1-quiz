    },
    "fs/s/b4d20f6f": {
      "text": "الأَسْماكُ وَالطُّيورُ وَالزُّهورُ لَها لَوْنٌ واحِدٌ",
      "hash": "e210be3e0f6a6b78",
      "durationMs": 4542,
      "bytes": 36823
    },
    "fs/s/b51624a5": {
      "text": "لا إِلَهَ إِلّا اللهُ هِيَ كَلِمَةُ التَّوْحيدِ",
      "hash": "67f2baab150ac634",
      "durationMs": 4126,
      "bytes": 33479
    },
    "fs/s/b627e5e2": {
      "text": "مَنْ خَلَقَ الأَرْضَ وَالسَّماءَ؟",
      "hash": "81a742e2eae81bd5",
      "durationMs": 2331,
      "bytes": 19269
    },
    "fs/s/b7630011": {
      "text": "مَعْنى أَفْواجًا: جَماعاتٌ",
      "hash": "68d6df76e73712ed",
      "durationMs": 3200,
      "bytes": 26165
    },
    "fs/s/b981042c": {
      "text": "العَمَلُ بِكَلِمَةِ التَّوْحيدِ جَزاؤُهُ",
      "hash": "6d761ce7228ec950",
      "durationMs": 3357,
      "bytes": 27419
    },
    "fs/s/ba69cee5": {
      "text": "الكَلامِ السَّيِّئِ",
      "hash": "2c818cac55684dcb",
      "durationMs": 1645,
      "bytes": 13626
    },
    "fs/s/bd82aa24": {
      "text": "القَلْبِ",
      "hash": "1dcd1a5f88c09b40",
      "durationMs": 1064,
      "bytes": 9029
    },
    "fs/s/bf125bdf": {
      "text": "سُبْحانَ اللهِ",
      "hash": "efca84ef27f25ab8",
      "durationMs": 1643,
      "bytes": 13626
    },
    "fs/s/c21ef525": {
      "text": "بِفَتْحِ مَكَّةَ",
      "hash": "307c7b7b4b7c8373",
      "durationMs": 1377,
      "bytes": 11536
    },
    "fs/s/c5616e3b": {
      "text": "أَصْحابِ النَّبِيِّ صَلّى اللهُ عَلَيْهِ وَسَلَّمَ",
      "hash": "4999573a4ccbcd06",
      "durationMs": 3304,
      "bytes": 27001
    },
    "fs/s/c607c379": {
      "text": "بِاللهِ",
      "hash": "7b2f8b3dd2a47b24",
      "durationMs": 1152,
      "bytes": 9865
    },
    "fs/s/c770539d": {
      "text": "وَالقَدَرِ خَيْرِهِ وَشَرِّهِ",
      "hash": "b0b7d2bb8865e0b5",
      "durationMs": 2634,
      "bytes": 21567
    },
    "fs/s/c7eebc9a": {
      "text": "آياتُها ثَلاثٌ",
      "hash": "6d4865a61f430ad1",
      "durationMs": 1978,
      "bytes": 16343
    },
    "fs/s/ccc5cd95": {
      "text": "الَّذي أَعْطى كُلَّ مَخْلوقٍ شَكْلَهُ وَصورَتَهُ وَهَيْئَتَهُ الخاصَّةَ",
      "hash": "1b1dece2d1ab67bd",
      "durationMs": 5653,
      "bytes": 45809
    },
    "fs/s/cce7e157": {
      "text": "ضع دائرة حول أركان الإيمان",
      "hash": "118245e69fc99fde",
      "durationMs": 2592,
      "bytes": 21358
    },
    "fs/s/cd17579f": {
      "text": "وَاليَوْمِ الآخِرِ",
      "hash": "51438ec128b7f2a3",
      "durationMs": 1670,
      "bytes": 13835
    },
    "fs/s/d0eac586": {
      "text": "لا إِلَهَ إِلّا اللهُ",
      "hash": "204f69dfd63d4813",
      "durationMs": 2554,
      "bytes": 20940
    },
    "fs/s/d4a2a910": {
      "text": "عَبْدٍ",
      "hash": "302a3a0fb0a39d2a",
      "durationMs": 1007,
      "bytes": 8611
    },
    "fs/s/d66d2e98": {
      "text": "إيتاءُ الزَّكاةِ",
      "hash": "8bc7cb304eca937c",
      "durationMs": 1710,
      "bytes": 14253
    },
    "fs/s/d9153c9f": {
      "text": "الإيمانُ: ما اسْتَقَرَّ في القَلْبِ وَصَدَّقَهُ العَمَلُ",
      "hash": "5fbc65528248a867",
      "durationMs": 4615,
      "bytes": 37450
    },
    "fs/s/d9e55228": {
      "text": "رَضِيَ اللهُ عَنْهُ",
      "hash": "56c4b08cd0995602",
      "durationMs": 1613,
      "bytes": 13417
    },
    "fs/s/daf372f0": {
      "text": "مَعْنى الخالِقِ:",
      "hash": "5c7dfd728083fcc8",
      "durationMs": 1680,
      "bytes": 14044
    },
    "fs/s/defebcb1": {
      "text": "وَكُتُبِهِ",
      "hash": "589083f7194fc0e1",
      "durationMs": 1200,
      "bytes": 10074
    },
    "fs/s/e29c8dfe": {
      "text": "اللهَ تَعالى",
      "hash": "7e97abf8d6c20b1b",
      "durationMs": 1474,
      "bytes": 12372
    },
    "fs/s/e2ddc51e": {
      "text": "السُّؤالُ الثّاني كانَ عَنِ:",
      "hash": "d3a93d6935ce7563",
      "durationMs": 2296,
      "bytes": 18851
    },
    "fs/s/e444049f": {
      "text": "اللهُ تَعالى",
      "hash": "10a500d9f9cfc33c",
      "durationMs": 1558,
      "bytes": 12999
    },
    "fs/s/e48219c0": {
      "text": "اللهُ تَعالى خالِقُ الأَرْضِ وَالسَّماءِ وَما فيهِما",
      "hash": "ba87ca33ab5eaf07",
      "durationMs": 4428,
      "bytes": 35987
    },
    "fs/s/e5067d90": {
      "text": "الإيمانُ بِاللهِ",
      "hash": "cdb087cbb529ee55",
      "durationMs": 1777,
      "bytes": 14880
    },
    "fs/s/e532799a": {
      "text": "بِاللَّعِبِ",
      "hash": "c59c7e806e3f4432",
      "durationMs": 1070,
      "bytes": 9029
    },
    "fs/s/e5f21ce9": {
      "text": "كانَ أَبو لَهَبٍ وَامْرَأَتُهُ مِنْ أَشَدِّ النّاسِ إيذاءً لِلرَّسولِ صَلّى اللهُ عَلَيْهِ وَسَلَّمَ",
      "hash": "e637773fb4ae8929",
      "durationMs": 7176,
      "bytes": 57930
    },
    "fs/s/ecd7c368": {
      "text": "صَلّى اللهُ عَلَيْهِ وَسَلَّمَ",
      "hash": "cc6a839099f53b6e",
      "durationMs": 2279,
      "bytes": 18851
    },
    "fs/s/efd3db35": {
      "text": "جِبْريلُ عَلَيْهِ السَّلامُ",
      "hash": "73f22dde2ddda5c2",
      "durationMs": 1962,
      "bytes": 16343
    },
    "fs/s/f13ea69a": {
      "text": "بِماذا بَشَّرَ اللهُ تَعالى نَبِيَّنا مُحَمَّدًا صَلّى اللهُ عَلَيْهِ وَسَلَّمَ؟",
      "hash": "458efc86e10796f0",
      "durationMs": 5647,
      "bytes": 45809
    },
    "fs/s/f143e834": {
      "text": "سورَةُ المَسَدِ مَكِّيَّةٌ",
      "hash": "7ef9d445a10c5332",
      "durationMs": 2515,
      "bytes": 20732
    },
    "fs/s/f172ece1": {
      "text": "آياتُها خَمْسٌ",
      "hash": "892a0fcd64b0dfeb",
      "durationMs": 1950,
      "bytes": 16134
    },
    "fs/s/f20d8ded": {
      "text": "صورَةٍ",
      "hash": "a33c675cca75ec03",
      "durationMs": 1136,
      "bytes": 9656
    },
    "fs/s/f2f45452": {
      "text": "وَدَفاتِرِهِ",
      "hash": "13ab5c50a2ed171f",
      "durationMs": 1378,
      "bytes": 11536
    },
    "fs/s/f3615874": {
      "text": "ثَوْبي",
      "hash": "42cf988be7f44fe6",
      "durationMs": 935,
      "bytes": 7984
    },
    "fs/s/f366d79c": {
      "text": "اللهُ تَعالى خالِقُ كُلِّ شَيْءٍ",
      "hash": "d9e648cb495f556a",
      "durationMs": 3200,
      "bytes": 26165
    },
    "fs/s/f55fdbd3": {
      "text": "وَيَوْمِ العيدِ",
      "hash": "2a7aca05df2c4397",
      "durationMs": 1520,
      "bytes": 12790
    },
    "fs/s/f6d6d969": {
      "text": "عَنْ عُمَرَ بْنِ الخَطّابِ رَضِيَ اللهُ عَنْهُ قالَ: جاءَ جِبْريلُ عَلَيْهِ السَّلامُ إِلى النَّبِيِّ صَلّى اللهُ عَلَيْهِ وَسَلَّمَ وَسَأَلَهُ: فَأَخْبِرْني عَنِ الإيمانِ، قالَ: أَنْ تُؤْمِنَ بِاللهِ وَمَلائِكَتِهِ وَكُتُبِهِ وَرُسُلِهِ وَاليَوْمِ الآخِرِ، وَتُؤْمِنَ بِالقَدَرِ خَيْرِهِ وَشَرِّهِ",
      "hash": "29d910183777e882",
      "durationMs": 19720,
      "bytes": 158240
    },
    "fs/s/f9def7b2": {
      "text": "عَمِّ النَّبِيِّ صَلّى اللهُ عَلَيْهِ وَسَلَّمَ أَبي لَهَبٍ وَزَوْجَتِهِ",
      "hash": "50993816b080ddd1",
      "durationMs": 4954,
      "bytes": 40167
    },
    "fs/s/ff24364e": {
      "text": "بِالقَدَرِ",
      "hash": "4b7e9ca5e59a5c9f",
      "durationMs": 1120,
      "bytes": 9447
    }
  }
}
